# Production URL, no trailing slash. Enables canonical URLs, absolute OG
# URLs and the sitemap reference in robots.txt. Leave unset until the
# domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# Prince's personal Telegram (e.g. https://t.me/<handle>). While unset,
# every "Connect with Prince on Telegram" CTA is hidden.
NEXT_PUBLIC_CEO_TELEGRAM_URL=
